# Copie para .env (os scripts iniciar.cmd e iniciar.sh fazem isso e geram senhas aleatórias).

# Porta do navegador: http://localhost:8080
APP_PORT=8080
# Chave secreta do Django. Gere uma longa e aleatória; nunca publique a sua.
APP_SECRET_KEY=troque-esta-chave
# Endereços pelos quais o Lume será acessado (separe com vírgula). Ex.: localhost,127.0.0.1,lume.suaempresa.com
APP_ALLOWED_HOSTS=localhost,127.0.0.1
# Só quando houver HTTPS na frente (proxy reverso): true e a origem completa abaixo.
APP_HTTPS=false
APP_CSRF_TRUSTED_ORIGINS=

# Contas e documentos de demonstração no primeiro início (num banco vazio).
APP_SEED_DEMO=true
# Qualquer pessoa pode criar conta na tela de entrada?
APP_SIGNUP=true
APP_MAX_UPLOAD_MB=200
APP_TIMEZONE=America/Sao_Paulo
APP_LOG_LEVEL=INFO

# PostgreSQL
DB_NAME=lume
DB_USER=lume
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# Descrição por IA: local (padrão, sem chave), anthropic ou openai (qualquer API compatível: OpenAI, Ollama...).
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Capacidade de processamento
WEB_WORKERS=2
WORKER_THREADS=2
PROCESSOR_CONCURRENCY=2
